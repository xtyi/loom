{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.invalid/schemas/experimental/package.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "loom-package-exp/1"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "static-tensors",
          "single-stream",
          "cpu-sync",
          "cuda-stream"
        ]
      }
    },
    "meta": {
      "type": "object"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "target": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "abi": {
          "enum": [
            "loom.cpu.exp.v1",
            "loom.cuda.exp.v1"
          ]
        },
        "os": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64",
            "x86",
            "arm"
          ]
        },
        "endianness": {
          "enum": [
            "little",
            "big"
          ]
        },
        "pointer_bits": {
          "enum": [
            32,
            64
          ]
        },
        "compute_capability": {
          "type": "integer",
          "minimum": 10,
          "maximum": 999
        }
      },
      "required": [
        "backend",
        "abi",
        "os",
        "arch",
        "endianness",
        "pointer_bits"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "backend": {
              "const": "cpu"
            },
            "abi": {
              "const": "loom.cpu.exp.v1"
            }
          },
          "not": {
            "required": [
              "compute_capability"
            ]
          }
        },
        {
          "properties": {
            "backend": {
              "const": "cuda"
            },
            "abi": {
              "const": "loom.cuda.exp.v1"
            }
          },
          "required": [
            "compute_capability"
          ]
        }
      ]
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000]+$"
    },
    "kernels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000]+$"
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000]+$"
          }
        },
        "required": [
          "slot",
          "file"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "name",
    "target",
    "plan",
    "kernels",
    "constants"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "backend": {
                "const": "cpu"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "required_capabilities": {
            "items": {
              "enum": [
                "static-tensors",
                "single-stream",
                "cpu-sync"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "backend": {
                "const": "cuda"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "required_capabilities": {
            "items": {
              "enum": [
                "static-tensors",
                "single-stream",
                "cuda-stream"
              ]
            }
          }
        }
      }
    }
  ]
}
