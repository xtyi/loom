if(DEFINED PROBE)
  execute_process(COMMAND "${PROBE}" resources "${ADD}" "${RELU}" "${CPU_ADD}" "${FIXTURE}" "${PACKAGE}"
    RESULT_VARIABLE ready)
  if(ready EQUAL 77)
    message("SKIP: no CUDA device")
    return()
  elseif(NOT ready EQUAL 0)
    message(FATAL_ERROR "CUDA readiness probe failed")
  endif()
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(REMOVE "${OUTPUT}/0.bin")
execute_process(COMMAND "${CLI}" run "${PACKAGE}" "${OUTPUT}" "${PACKAGE}/inputs/0.bin"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "CLI run failed: ${output}${error}")
endif()
file(READ "${OUTPUT}/0.bin" actual HEX)
file(READ "${PACKAGE}/package.json" manifest)
string(JSON endian GET "${manifest}" target endianness)
if(endian STREQUAL "little")
  set(expected "00000000000000000000000000000040000080400000c040")
else()
  set(expected "000000000000000000000000400000004080000040c00000")
endif()
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Wrong output bytes: ${actual}")
endif()
execute_process(COMMAND "${CLI}" run "${PACKAGE}" "${OUTPUT}" "${PACKAGE}/inputs/0.bin"
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "output already exists")
  message(FATAL_ERROR "CLI silently overwrote an existing result")
endif()
