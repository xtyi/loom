{
  "format": "loom-package-exp/1",
  "name": "add-relu-@LOOM_PACKAGE_BACKEND@",
  "target": {
    "backend": "@LOOM_PACKAGE_BACKEND@",
    "abi": "loom.@LOOM_PACKAGE_BACKEND@.exp.v1",
    "os": "@LOOM_PACKAGE_OS@",
    "arch": "@LOOM_PACKAGE_ARCH@",
    "endianness": "@LOOM_PACKAGE_ENDIAN@",
    "pointer_bits": @LOOM_PACKAGE_POINTER_BITS@@LOOM_PACKAGE_DEVICE_TARGET@
  },
  "required_capabilities": ["static-tensors", "single-stream", "@LOOM_PACKAGE_EXECUTION@"],
  "plan": "plans/main.json",
  "kernels": ["kernels/add/ku.json", "kernels/relu_scale/ku.json"],
  "constants": [{"slot": 1, "file": "weights/bias.bin"}],
  "meta": {"description": "y = relu(x + bias) * 2"}
}
